Cell[BoxData[
    \("t->torusknot[a,b,c][p,q][t] is a torus knot of type (p,q) on an \
elliptical torus of type (a,b,c).  To plot try torusknot[8,3,5][2,5][0,3Pi]."\
\)], "Print",
  CellTags->"Info3456944309-1139232"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
    \(g = 
      ParametricPlot3D[\[IndentingNewLine]\(\(tubecurve[\[IndentingNewLine]\(\
torusknot[8, 3, 5]\)[1, 12]]\)[1.2]\)[t, theta] // 
          Evaluate, \[IndentingNewLine]{t, 0, 
          2  Pi}, \[IndentingNewLine]{theta, 0, 
          2  Pi}, \[IndentingNewLine]PlotPoints \[Rule] {360, 
            12}, \[IndentingNewLine]Boxed \[Rule] 
          False, \[IndentingNewLine]Axes \[Rule] None]\)], "Input"],

