Cell[CellGroupData[{

Cell[BoxData[
    \(\(?helix\)\)], "Input"],

Cell[BoxData[
    \("t->helix[a,b][t] is a circular helix of radius a and slant b. \
t->helix[a,b,c][t] is an elliptical helix of slant c."\)], "Print",
  CellTags->"Info3456924620-3707547"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
    \(\(\(\(tubecurve[helix[a, b]]\)[r]\)[t, theta] // PowerExpand\) // 
      Simplify\)], "Input"],

Cell[BoxData[
    \({\((a\ \((Cos[
                    t]\ \((\@\(a\^2 + b\^2\)\ \@\(a\^2\ \((a\^2 + b\^2)\)\) + \
\((a\^2 + b\^2)\)\ r\ Cos[theta])\) + 
                b\ \@\(a\^2 + b\^2\)\ r\ Sin[t]\ Sin[
                    theta])\))\)/\((\@\(a\^2 + b\^2\)\ \@\(a\^2\ \((a\^2 + \
b\^2)\)\))\), \((a\ \((\((\@\(a\^2 + b\^2\)\ \@\(a\^2\ \((a\^2 + b\^2)\)\) + \
\((a\^2 + b\^2)\)\ r\ Cos[theta])\)\ Sin[t] - 
                b\ \@\(a\^2 + b\^2\)\ r\ Cos[t]\ Sin[
                    theta])\))\)/\((\@\(a\^2 + b\^2\)\ \@\(a\^2\ \((a\^2 + \
b\^2)\)\))\), 
      b\ t + \(a\^2\ r\ Sin[theta]\)\/\@\(a\^2\ \((a\^2 + b\^2)\)\)}\)], \
"Output"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
    \(ParametricPlot3D[\(\(tubecurve[helix[2,  .5]]\)[ .5]\)[t, theta] // 
        Evaluate, {theta, 0, 2  Pi}, {t, 0, 8  Pi}, 
      PlotPoints \[Rule] {20, 60}, Axes \[Rule] None]\)], "Input"],

