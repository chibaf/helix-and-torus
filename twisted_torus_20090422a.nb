(*WindowFrame->Normal*)



Notebook[{
Cell[BoxData[{
    \(\(r[x_, y_, t_, u_] := 
        x[t] Cos[u] - y[t] Sin[u];\)\), "\[IndentingNewLine]", 
    \(\(z[x_, y_, t_, u_] := 
        x[t] Sin[u] + y[t] Cos[u];\)\), "\[IndentingNewLine]", 
    \(tube[{x_, y_, a_:  0, b_: \((2  Pi)\)}, \[IndentingNewLine]{radius_, 
          twist_, revs_:  1}, opts___] := \[IndentingNewLine]ParametricPlot3D[
        Evaluate[\[IndentingNewLine]{\((radius + r[x, y, t, twist*\ u])\) 
              Cos[u], \[IndentingNewLine]\((radius + r[x, y, t, twist*\ u])\) 
              Sin[u], \[IndentingNewLine]z[x, y, t, 
              twist*\ u]}], \[IndentingNewLine]{t, a, 
          b}, \[IndentingNewLine]{u, 0, 
          2*\ revs\ *
            Pi}, \[IndentingNewLine]opts, \[IndentingNewLine]Boxed \[Rule] 
          False, \[IndentingNewLine]Axes \[Rule] False]\)}], "Input"],

Cell[CellGroupData[{

Cell[BoxData[
    \(torus\  = \ 
      tube[{Cos, Sin}, {5, 3}, PlotPoints \[Rule] {16, 48}, 
        LightSources \[Rule] {{{2, \(-1\), 3}, 
              RGBColor[1, 1, 0]}, {{\(-1.5\), \(-0.5\), 1}, 
              RGBColor[0, 0, 1]}, {{0, 1, 1}, RGBColor[1, 0, 0]}}]\)], "Input"],

Cell[GraphicsData["PostScript", "\<\
